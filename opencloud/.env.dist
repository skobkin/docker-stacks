# OpenCloud configuration. Copy this file to .env and edit it:
#   cp .env.dist .env
#
# OpenCloud (opencloud.eu) is the open-source file sync and share platform
# from the original ownCloud team — the successor of ownCloud Infinite Stack
# (oCIS). This stack runs the all-in-one image: web frontend, built-in IdP
# and reverse proxy in a single process, no external database.
#
# Official container deployment reference:
# https://docs.opencloud.eu/docs/admin/getting-started/container/docker-compose/docker-compose-base

# Docker image tag. The major-version tag tracks the stable 7.x line
# (currently 7, 7.2, 7.2.x, ...); pin a full version to freeze updates.
# https://hub.docker.com/r/opencloudeu/opencloud/tags
IMAGE_TAG=7

# Standard repo logging defaults.
LOG_MAX_SIZE=5m
LOG_MAX_FILE=5

# --- Instance identity ---------------------------------------------------------

# Public URL of this instance; every generated share link and OIDC redirect
# uses it, so set it before the first start and keep it stable afterwards.
#   default variant:  http://127.0.0.1:9200  (or http://<BIND_ADDRESS>:<BIND_PORT>)
#   traefik variant:  https://<TRAEFIK_HOST>
OC_URL=https://opencloud.example.com

# Password of the initial `admin` account. IMPORTANT: it is only read on the
# FIRST start of a fresh data directory (./data); later changes to this value
# are IGNORED — rotate the password via the web UI or the `opencloud idm` CLI
# afterwards. Without a value the built-in IdP fails and the container
# restart-loops, so keep it set.
INITIAL_ADMIN_PASSWORD=replace-with-initial-admin-password

## Create a set of demo users on the first start.
#IDM_CREATE_DEMO_USERS=false

## Default UI language for new users (empty = application default).
#OC_DEFAULT_LANGUAGE=en

# --- Logging and security --------------------------------------------------------

#OC_LOG_LEVEL=info
#OC_LOG_COLOR=false
#OC_LOG_PRETTY=false
## Trust invalid TLS certificates on outgoing connections (self-signed infra).
#OC_INSECURE=false
## Basic auth in front of the IdP endpoints of the built-in proxy.
#PROXY_ENABLE_BASIC_AUTH=false

## Password policy (upstream defaults shown).
#OC_PASSWORD_POLICY_DISABLED=false
#OC_PASSWORD_POLICY_MIN_CHARACTERS=8
#OC_PASSWORD_POLICY_MIN_LOWERCASE_CHARACTERS=1
#OC_PASSWORD_POLICY_MIN_UPPERCASE_CHARACTERS=1
#OC_PASSWORD_POLICY_MIN_DIGITS=1
#OC_PASSWORD_POLICY_MIN_SPECIAL_CHARACTERS=1

## Public links must have a password (upstream defaults shown).
#OC_SHARING_PUBLIC_SHARE_MUST_HAVE_PASSWORD=true
#OC_SHARING_PUBLIC_WRITEABLE_SHARE_MUST_HAVE_PASSWORD=false

## Upload size limit of the web archiver, in bytes.
#FRONTEND_ARCHIVER_MAX_SIZE=10000000000

## Show the "new version available" banner in the web UI.
#FRONTEND_CHECK_FOR_UPDATES=true

# --- Email notifications (SMTP) ------------------------------------------------------
# All empty by default: OpenCloud runs without outbound mail until configured.
#NOTIFICATIONS_SMTP_HOST=
#NOTIFICATIONS_SMTP_PORT=
#NOTIFICATIONS_SMTP_SENDER=
#NOTIFICATIONS_SMTP_USERNAME=
#NOTIFICATIONS_SMTP_PASSWORD=
#NOTIFICATIONS_SMTP_INSECURE=
#NOTIFICATIONS_SMTP_AUTHENTICATION=
#NOTIFICATIONS_SMTP_ENCRYPTION=

# --- Optional service: full-text search (COMPOSE_PROFILES=fulltext) ------------------
# Adds an Apache Tika container used as the content extractor. Uncomment the
# variables below together with enabling the profile. `latest` is fine;
# `-full` image variants add OCR support.
#TIKA_IMAGE_TAG=latest
#SEARCH_EXTRACTOR_TYPE=tika
#SEARCH_EXTRACTOR_TIKA_TIKA_URL=http://tika:9998
#FRONTEND_FULL_TEXT_SEARCH_ENABLED=true

# --- Optional service: Collabora Online (COMPOSE_PROFILES=collabora) -----------------
# Adds the Collabora office suite. Browsers reach Collabora directly, so it
# needs its own public DNS name routed via Traefik and, realistically, the
# traefik variant. Uncomment the whole block together with enabling the
# profile; OC_ADD_RUN_SERVICES must contain `collaboration` for the WOPI
# service inside the main container to start (comma-separate extra services,
# e.g. `collaboration,antivirus`).
#COLLABORA_HOST=collabora.example.com
#COLLABORA_ADMIN_USER=admin
#COLLABORA_ADMIN_PASSWORD=replace-with-collabora-admin-password
#COLLABORA_IMAGE_TAG=26.04.3.2.1
#OC_ADD_RUN_SERVICES=collaboration
#FRONTEND_APP_HANDLER_SECURE_VIEW_APP_ADDR=eu.opencloud.api.collaboration
# Role IDs defining which space roles get the office apps (upstream default).
#GRAPH_AVAILABLE_ROLES=b1e2218d-eef8-4d4c-b82d-0f1a1b48f3b5,a8d5fe5e-96e3-418d-825b-534dbdf22b99,fb6c3e19-e378-47e5-b277-9732f9de6e21,58c63c02-1d89-4572-916a-870abc5a1b7d,2d00ce52-1fc2-4dbc-8b95-a73b73395f5a,1c996275-f1c9-4e71-abdf-a42f6495e960,312c0871-5ef7-4b3a-85b6-0e4074c64049,aa97fe03-7980-45ac-9e50-b325749fd7e6
#COLLABORATION_APP_NAME=CollaboraOnline
#COLLABORATION_APP_PRODUCT=Collabora
## Set to true only for self-signed setups on the Collabora/OpenCloud URLs.
#COLLABORATION_APP_INSECURE=false
#COLLABORATION_CS3API_DATAGATEWAY_INSECURE=false
## Container-internal Collabora port used by its Traefik router.
#TRAEFIK_COLLABORA_SERVICE_PORT=9980

# --- Compose stack settings ---------------------------------------------------------

# Compose variant:
#   default - bridge networking, localhost-bound published port
#   traefik - default plus Traefik labels and the external Traefik network
#COMPOSE_VARIANT=default

# Optional extra services, comma-separated (all off by default):
#   fulltext  - Apache Tika full-text search extractor
#   collabora - Collabora Online office suite (uncomment its block above;
#               needs COLLABORA_HOST and, realistically, the traefik variant)
#COMPOSE_PROFILES=

# Localhost-bound published port (default and traefik variants).
#BIND_ADDRESS=127.0.0.1
#BIND_PORT=9200

# Host directories. All three must exist and be owned by HOST_USER:HOST_GROUP.
#HOST_CONFIG_DIR=./config
#HOST_DATA_DIR=./data
#HOST_APPS_DIR=./config/apps

# Host UID/GID the container runs as (the image expects 1000:1000).
#HOST_USER=1000
#HOST_GROUP=1000

# Timezone assigned to the container.
#TZ=UTC

# Optional Traefik settings used by the traefik variant and the Collabora
# router.
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure
# Access policy defaults to default-access@file. Use public-access@file only
# when explicitly exposing the stack.
#TRAEFIK_ACCESS_POLICY=default-access@file
#TRAEFIK_HOST=opencloud.example.com
# Container-internal service port.
#TRAEFIK_SERVICE_PORT=9200

# --- Do not set these here -------------------------------------------------------
# The compose file owns the following variables and overrides anything set in
# this file, so editing them here is silently ignored:
#   PROXY_TLS                    (fixed to false; TLS terminates at Traefik)
#   COLLABORATION_WOPI_SRC       (derived from OC_URL)
#   COLLABORATION_APP_ADDR/_ICON (derived from COLLABORA_HOST)
