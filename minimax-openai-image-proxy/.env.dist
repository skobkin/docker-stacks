# minimax-openai-image-proxy configuration
# https://git.skobk.in/skobkin/minimax-openai-image-proxy

IMAGE_TAG=latest

# Compose helper mode:
#   default - standalone localhost-bound container on the ai-tools network
#   traefik - adds Traefik labels and joins the external Traefik network
#COMPOSE_VARIANT=default

# Listening interface for the local proxy port (default variant only).
HTTP_BIND_ADDR=127.0.0.1
HTTP_BIND_PORT=8407

# Optional upstream override. Defaults to the vendor base URL baked into the image.
#MINIMAX_BASE_URL=https://api.minimax.chat/v1

# Optional per-request timeout for upstream calls. Default in the binary is 120s.
#UPSTREAM_TIMEOUT=120s

# Logging
LOG_MAX_SIZE=5m
LOG_MAX_FILE=5

# Optional Traefik settings used by COMPOSE_VARIANT=traefik.
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINTS=websecure

# Access policy defaults to default-access@file. Use public-access@file only when explicitly exposing the stack.
#TRAEFIK_ACCESS_POLICY=default-access@file

# Public hostname served by Traefik.
#TRAEFIK_HOST=image.example.com

# Internal proxy port exposed to Traefik.
#TRAEFIK_SERVICE_PORT=8080
