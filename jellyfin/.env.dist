# Official image. latest tracks the current stable Jellyfin release
# (10.x line). Pin to a versioned tag such as `10.10.7` for pinned
# deployments. Jellyfin 12 release-candidate tags are available
# (e.g. `12.0-rc5`); uncomment to test deliberately without enabling
# prereleases by default.
# https://hub.docker.com/r/jellyfin/jellyfin/tags
#DOCKER_IMAGE=jellyfin/jellyfin
IMAGE_TAG=latest
#IMAGE_TAG=12.0-rc5

# Container UID/GID. Use the numeric host user/group that owns the media
# files so Jellyfin can write NFO files, downloaded artwork, subtitles,
# and similar sidecar metadata alongside the media.
HOST_USER=1000
HOST_GROUP=1000

# Persistent Jellyfin storage.
HOST_CONFIG_DIR=./config
HOST_CACHE_DIR=./cache
# Media directory is required. Mounted read-write by default so Jellyfin
# can write sidecar metadata. Set MEDIA_READ_ONLY to any non-empty value
# (for example `1`) to mount the path read-only; leave unset for the
# default read-write mount.
HOST_MEDIA_DIR=/mnt/multimedia
INT_MEDIA_DIR=/media
#MEDIA_READ_ONLY=1

# Optional additional media mounts (up to 4). Each slot maps a host path
# to /libraries/<label> inside the container (a sibling tree of /media,
# not nested inside it). Configure Jellyfin libraries against those
# in-container paths. Leave a slot unset to skip it entirely (the
# compose default is /dev/null, which is harmless).
# Example labels: movies, tv, music, books.
#EXTRA_MOUNT_1=/mnt/movies
#EXTRA_MOUNT_1_LABEL=movies
#EXTRA_MOUNT_2=/mnt/tv
#EXTRA_MOUNT_2_LABEL=tv
#EXTRA_MOUNT_3=/mnt/music
#EXTRA_MOUNT_3_LABEL=music
#EXTRA_MOUNT_4=/mnt/books
#EXTRA_MOUNT_4_LABEL=books

# Localhost-bound direct Web UI. Default port 8096 matches the upstream
# Jellyfin default and the Emby stack in this repo. If you run both
# Emby and Jellyfin on the same host, change WEBUI_BIND_PORT on one of
# them (for example WEBUI_BIND_PORT=8097 for Jellyfin) before starting.
WEBUI_BIND_ADDR=127.0.0.1
WEBUI_BIND_PORT=8096
WEBUI_INT_BIND_PORT=8096

# Container timezone and logging limits.
TZ=UTC
LOG_MAX_SIZE=5m
LOG_MAX_FILE=5

# Optional AMD VA-API hardware acceleration. Set VIDEO_ACCEL_DEVICE to
# the host render node (normally /dev/dri/renderD128). Set
# VIDEO_RENDER_GROUP to the host render group GID; discover it with:
#   getent group render | cut -d: -f3
# Do not hardcode distro-specific GIDs in this file.
#VIDEO_ACCEL_DEVICE=/dev/dri/renderD128
#VIDEO_RENDER_GROUP=108

# Optional network mode override. Default is bridge so the proxy /
# traefik variants can join the external networks. Set to `host` for
# host networking; when host networking is active, the ports mapping is
# ignored by Docker and the proxy / traefik variants stop working
# because the container cannot join the external networks.
#NETWORK_MODE=host

# Optional Traefik reverse proxy. Set COMPOSE_VARIANT=traefik (or
# traefik_proxy) to attach the service to the Traefik network.
#COMPOSE_VARIANT=default

#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_ACCESS_POLICY=default-access@file
#TRAEFIK_HOST=jellyfin.example.com

# Optional SOCKS5 proxy for outbound metadata/image/plugin HTTP(S)
# traffic (TMDb, OMDb, plugin feeds). Uncomment and edit to use the
# repository's `mihomo` service or any other reachable SOCKS5
# endpoint, including endpoints outside the Docker network. The
# variables are intentionally not defined in the Compose file; add
# them to your `.env` when needed.
#ALL_PROXY=socks5://mihomo:1050
#HTTPS_PROXY=socks5://mihomo:1050
#NO_PROXY=localhost,127.0.0.1

# External network names referenced by the proxy / traefik variants.
PROXY_NETWORK=proxy
