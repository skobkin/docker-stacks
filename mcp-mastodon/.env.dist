# Mastodon MCP image tag. "latest" follows the most recent upstream release.
IMAGE_TAG=latest

# Compose variant: default, proxy, traefik, or traefik_proxy.
COMPOSE_VARIANT=default
PROXY_NETWORK=proxy

# Optional Traefik settings used by COMPOSE_VARIANT=traefik or traefik_proxy.
#TRAEFIK_HOST=mcp-mastodon.example.com
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure

# Access policy defaults to default-access@file. Use public-access@file only
# when intentionally exposing this authenticated MCP endpoint publicly.
#TRAEFIK_ACCESS_POLICY=default-access@file

# Mastodon-compatible instance origin (no trailing path).
# Examples: https://mastodon.social, https://gts.example, https://social.example
MASTODON_MCP_MASTODON__BASE_URL=https://social.example

# Auth. The stack ships with MASTODON_MCP_AUTH__MODE=request-header baked
# into docker-compose.yml, so the MCP client sends the Mastodon access token
# on every request in MASTODON_MCP_AUTH__REQUEST_HEADER (default
# X-Mastodon-Access-Token) — no server-side token is configured. To run with
# a single baked-in identity instead, edit docker-compose.yml to change the
# mode to "static" or "hybrid", then uncomment one of the static token
# sources below. The upstream rejects both static sources being set at once.
#MASTODON_MCP_AUTH__REQUEST_HEADER=X-Mastodon-Access-Token
#MASTODON_MCP_AUTH__TOKEN=
#MASTODON_MCP_AUTH__TOKEN_FILE=/run/secrets/mastodon-token

# Local HTTP endpoint. Keep the default localhost binding unless access is
# protected by another network layer.
BIND_ADDR=127.0.0.1
BIND_PORT=8416

# Optional Mihomo proxy settings used with COMPOSE_VARIANT=proxy.
# The upstream HTTP client reads HTTP_PROXY / HTTPS_PROXY / NO_PROXY via Go's
# net/http ProxyFromEnvironment; this only takes effect because
# MASTODON_MCP_HTTP__PROXY_FROM_ENVIRONMENT defaults to true. As an explicit
# override (preferred when only one proxy is needed), set the upstream
# MASTODON_MCP_HTTP__PROXY_URL variable instead of the three below.
#HTTP_PROXY=socks5://mihomo:1050
#HTTPS_PROXY=socks5://mihomo:1050
#NO_PROXY=localhost,127.0.0.1,mcp-mastodon
#MASTODON_MCP_HTTP__PROXY_URL=socks5://mihomo:1050

LOG_MAX_SIZE=5m
LOG_MAX_FILE=5
