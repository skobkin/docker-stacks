# gopeed configuration
# https://github.com/GopeedLab/gopeed

IMAGE_TAG=v1.9.3

# Compose helper mode:
#   default       - standalone localhost-bound container on the default bridge
#   proxy         - joins the external proxy network (outbound downloads proxy)
#   traefik       - adds Traefik labels and joins the external Traefik network
#   traefik_proxy - both proxy and Traefik networks
#COMPOSE_VARIANT=default

# Listening interface and host port for the web UI / API.
BIND_ADDRESS=127.0.0.1
BIND_PORT=8421

# Host paths for the settings database and downloads.
HOST_CONFIG_DIR=./config
HOST_DOWNLOADS_DIR=./downloads

# The image starts as root and drops privileges itself via su-exec using
# PUID/PGID. A compose `user:` key would break the upstream entrypoint.
HOST_USER=1000
HOST_GROUP=1000
UMASK=022

# Web UI login (change before first start). Auth is enabled while the
# password is non-empty; set AUTH_PASSWORD empty to disable auth.
# Values reach the container via environment and are readable via
# `docker inspect`.
AUTH_USER=gopeed
AUTH_PASSWORD=*ChangeThis*
# Token required for HTTP API calls when auth is enabled.
#GOPEED_APITOKEN=

# Route downloads through a proxy (e.g. the mihomo SOCKS5 service on the
# proxy network). Requires COMPOSE_VARIANT=proxy or traefik_proxy.
# These values seed Gopeed's global proxy setting on FIRST start only;
# afterwards the proxy is managed in the web UI (Settings -> Proxy).
GOPEED_PROXY_ENABLE=false
GOPEED_PROXY_SCHEME=socks5
GOPEED_PROXY_HOST=mihomo
GOPEED_PROXY_PORT=1050

# Logging
LOG_MAX_SIZE=5m
LOG_MAX_FILE=5

# External network names referenced by the proxy / traefik variants.
PROXY_NETWORK=proxy
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure

# Access policy defaults to default-access@file. Use public-access@file only when explicitly exposing the stack.
#TRAEFIK_ACCESS_POLICY=default-access@file

# Public hostname served by Traefik.
#TRAEFIK_HOST=gopeed.example.com

# Internal container port exposed to Traefik.
#TRAEFIK_SERVICE_PORT=9999
