# see https://hub.docker.com/r/skobkin/telegram-llm-bot

# Bot image tag. Variable names below match upstream UPGRADE.md as of 0.23.0.
#IMAGE_TAG=latest

# Optional network variants: ai_tools, proxy, or ai_tools_proxy.
#COMPOSE_VARIANT=ai_tools
#PROXY_NETWORK=proxy

#HOST_DATA_DIR=./data

# Telegram Bot API token from @BotFather.
BOT__TELEGRAM__TOKEN=1234567890:your-telegram-bot-token

# OpenAI-compatible LLM backend. Use COMPOSE_VARIANT=ai_tools for repo-local llama-swap or Ollama.
#LLM__BACKENDS__OPENAI_COMPAT__BASE_URL=http://llama-swap:8080/v1
#LLM__BACKENDS__OPENAI_COMPAT__API_TOKEN=dummy

# Model used for normal chat requests. It must support OpenAI-compatible tool calls.
# Other feature models inherit this value when unset.
LLM__FEATURES__CHAT__MODEL=your-chat-model-name
#LLM__FEATURES__SUMMARIZE__MODEL=your-chat-model-name
#LLM__FEATURES__IMAGE_RECOGNITION__MODEL=your-chat-model-name

# Persistent SQLite store for admin config and reminders.
#PERSISTENT__STORE_PATH=/data/db.sqlite
# Comma-separated Telegram user IDs with admin access. Empty disables admin controls.
#BOT__ADMIN_IDS=123456789,987654321

# Optional external web search for the search_web tool: none, tavily, kagi, or chain.
#SEARCH__BACKEND=none
#SEARCH__CHAIN=tavily,kagi
#PROVIDERS__TAVILY__API_KEY=
#PROVIDERS__KAGI__API_KEY=

# Runtime tuning.
#LLM__TOOL_LOOP_MAX_ITERATIONS=6
#STATE__MAX_BYTES=268435456
#STATE__HISTORY_MAX_BYTES=167772160
#STATE__HISTORY_STREAMS_MAX=1024
#STATE__IMAGE_CACHE_MAX_BYTES=67108864
#STATE__IMAGE_CACHE_TTL=24h
#LLM__UNCOMPRESSED_HISTORY_LIMIT=15
#LLM__HISTORY_SUMMARY_THRESHOLD=5
#BOT__PROCESSING_TIMEOUT=30s

#HTTP_PROXY=socks5://mihomo:1050
#HTTPS_PROXY=socks5://mihomo:1050
#NO_PROXY=192.168.1.0/24,*.lan,llama-swap

#LOG__LEVEL=info
#SENTRY__DSN=

#LOG_MAX_SIZE=5m
#LOG_MAX_FILE=5
