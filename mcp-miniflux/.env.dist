# Miniflux MCP image tag. "latest" follows the most recent upstream release.
IMAGE_TAG=latest

# Compose variant: default or traefik. Proxy variants are intentionally
# unavailable — see compose.features.yml for the upstream Go-client caveat.
COMPOSE_VARIANT=default

# Optional Traefik settings used by COMPOSE_VARIANT=traefik.
#TRAEFIK_HOST=mcp-miniflux.example.com
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure

# Access policy defaults to default-access@file. Use public-access@file only
# when intentionally exposing this authenticated MCP endpoint publicly.
#TRAEFIK_ACCESS_POLICY=default-access@file

# Base URL of the Miniflux instance this MCP server talks to. No trailing
# path. Examples: https://rss.example.com, http://miniflux:8080.
MINIFLUX_URL=https://miniflux.example.com

# Auth between the MCP server and Miniflux.
#
# Default: API key. Generate one in Miniflux under Settings → API Keys
# (https://miniflux.app/docs/api.html#authentication), then paste the value
# below. The upstream fails fast if MINIFLUX_URL is set but neither an API
# key nor a username+password pair is configured.
MINIFLUX_API_KEY=

# Alternative: username + password basic auth. Comment out MINIFLUX_API_KEY
# above and uncomment both lines below to use this mode instead. The
# upstream rejects both modes being set at once.
#MINIFLUX_USERNAME=
#MINIFLUX_PASSWORD=

# Bearer token protecting the streamable HTTP endpoint. REQUIRED when
# MCP_TRANSPORT=streamable-http (the stack default). Pick a strong random
# value — MCP clients send it on every request as
# `Authorization: Bearer <value>`.
MCP_AUTH_TOKEN=

# Optional transport overrides. The stack sets MCP_TRANSPORT=streamable-http
# in docker-compose.yml; the two below only matter for tuning the listener.
#MCP_HTTP_ADDR=:8080
#MCP_HTTP_PATH=/mcp

# Local HTTP endpoint. Keep the default localhost binding unless access is
# protected by another network layer.
BIND_ADDR=127.0.0.1
BIND_PORT=8417

LOG_MAX_SIZE=5m
LOG_MAX_FILE=5
