# Luanti (formerly Minetest) dedicated server
# Container docs: https://docs.luanti.org/for-server-hosts/setup/containers/

# Engine image tag (ghcr.io/luanti-org/luanti).
# "5.17" tracks the current stable line incl. 5.17.x bugfix/security releases;
# use "5.17.0" to pin exactly, or "5" to track all stable releases.
IMAGE_TAG=5.17

# Game to run: "voxelibre" or "mineclonia" (install with ./install-game.sh,
# see README.md). Only used when a NEW world is created; existing worlds
# remember their game. Must always match the world selected below - loading
# an existing world with a mismatched GAME_ID can corrupt the world.
GAME_ID=voxelibre

# World name (directory under the data dir, e.g. data/.minetest/worlds/world).
# Use a separate world per game, e.g. "voxelibre" and "mineclonia".
WORLD_NAME=world

# Address and UDP port to publish the game protocol on.
# 0.0.0.0 exposes the server on all interfaces (LAN + public internet).
# Restrict access with the join password (config/minetest.conf) and/or a
# firewall or VPN - see README.md "Security" and "Networking".
BIND_ADDRESS=0.0.0.0
BIND_PORT=30000

# Host directories for server data, configuration, games and mods
# (relative to this stack directory, or absolute paths).
HOST_DATA_DIR=./data
HOST_CONFIG_DIR=./config
HOST_GAMES_DIR=./games
HOST_MODS_DIR=./mods

# Docker logging limits
LOG_MAX_SIZE=5m
LOG_MAX_FILE=5
