# https://docs.getbifrost.ai/
# https://github.com/maximhq/bifrost

# Upstream publishes only exact vX.Y.Z release tags (plus latest; no rolling
# v2/v2.4 tags exist). The default `latest` lets watchtower auto-update the
# image, but database migrations run on every startup and are NOT reversed by
# rolling the image back — back up data/ before upgrades (see README). Pin an
# exact tag to opt out of auto-updates.
#IMAGE_TAG=v2.4.0

# Compose variant. Traefik is the default; non-Traefik variants are the opt-out.
#   traefik - publish through the shared Traefik network (no host port)
#   default - standalone localhost-bound HTTP port
COMPOSE_VARIANT=traefik

# Host bind for the non-Traefik variant (default). Container always listens
# on 8080. Host 8080 is already taken by other stacks in this repo (see
# PORTS.md), so the default publish port here is 8422; change it only if you
# know 8080 is free on your host.
BIND_ADDRESS=127.0.0.1
BIND_PORT=8422

# Encryption key for secrets stored in the database (provider credentials,
# virtual keys). No default is generated: set it before first start, never
# change it afterwards, and back it up together with data/ — losing it makes
# stored secrets unreadable. Generate: openssl rand -base64 32
BIFROST_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# One-time bootstrap token used only to create the first admin account
# (presented in the Web UI on first start). Remove this line after the first
# admin exists. Generate: openssl rand -hex 32
BIFROST_SETUP_TOKEN=replace-with-output-of-openssl-rand-hex-32

# Provider API keys. By default providers are configured in the Web UI and
# keys are stored encrypted in the database; these variables are only read
# when the optional config.json seed is enabled (see README).
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# Host directory for the SQLite database, config store, and request logs.
# The image runs as UID/GID 1000: HOST_DATA_DIR must exist and be writable
# by 1000 before first start (see README).
HOST_DATA_DIR=./data

# Config seed file mounted at /app/data/config.json. By default the shipped
# no-op template is mounted; the file must exist and hold valid JSON even
# when it carries no settings, so never point this at an empty or missing
# path. To activate the declarative seed: copy config/config.json.dist to
# config/config.json, add settings, and uncomment the line (see README).
#HOST_CONFIG_FILE=./config/config.json

# Server log level: debug, info, warn, error (upstream default: info).
#LOG_LEVEL=info

# Log format: json (upstream default) or console for human-readable output.
#LOG_STYLE=console

# Go runtime tuning. GOMEMLIMIT is a soft memory limit; GOGC is the garbage
# collection target percentage. Defaults are usually fine.
# https://docs.getbifrost.ai/deployment-guides/docker-tuning
#GOMEMLIMIT=1500MiB
#GOGC=100

# Optional Traefik settings used by COMPOSE_VARIANT=traefik.
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure
# Access policy defaults to default-access@file. What it does depends on which
# middleware definition is active in your Traefik config; keep something in
# front of the dashboard until the first admin account exists (see README).
#TRAEFIK_ACCESS_POLICY=default-access@file
#TRAEFIK_HOST=bifrost.example.com
#TRAEFIK_SERVICE_PORT=8080

# Standard repo logging defaults.
LOG_MAX_SIZE=5m
LOG_MAX_FILE=5

# Timezone passed to the container.
#TZ=UTC
