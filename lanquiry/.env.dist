# LANquiry configuration. Copy this file to .env and edit it:
#   cp .env.dist .env
#
# LANquiry is configured through LANQUIRY_* environment variables only; no
# configuration file is mounted. Indexed list variables such as
# LANQUIRY_SOURCES_ROUTEROS_0_ADDRESS require image 0.1.0-rc2 or newer.
#
# Full option reference:
# https://github.com/skobkin/LANquiry/blob/master/docs/configuration.md

# Docker image tag.
IMAGE_TAG=latest

# Standard repo logging defaults.
LOG_MAX_SIZE=5m
LOG_MAX_FILE=5

# --- Administrator access ----------------------------------------------------

# Argon2id hash of the administrator password; the app refuses to start
# without it. Generate one with:
#   docker compose run --rm lanquiry hash-password
LANQUIRY_AUTH_ADMIN_PASSWORD_HASH=replace-with-output-from-hash-password

## Login name of the administrator account.
#LANQUIRY_AUTH_ADMIN_USERNAME=admin

## Login session lifetime.
#LANQUIRY_AUTH_SESSION_TTL=24h

# --- RouterOS source ----------------------------------------------------------
# Read-only account on the router (see README.md for creating one). The address
# needs no port: plain API 8728 is assumed, set LANQUIRY_SOURCES_ROUTEROS_0_TLS
# for the TLS API on 8729.
#
# Comment all three variables out to run with local mDNS/SSDP discovery only.
LANQUIRY_SOURCES_ROUTEROS_0_ADDRESS=192.168.88.1
LANQUIRY_SOURCES_ROUTEROS_0_USERNAME=lanquiry-readonly
LANQUIRY_SOURCES_ROUTEROS_0_PASSWORD=replace-with-the-readonly-password

## Optional display name of the source.
#LANQUIRY_SOURCES_ROUTEROS_0_NAME=

## Use the TLS API service (port 8729). Only this flag selects TLS.
#LANQUIRY_SOURCES_ROUTEROS_0_TLS=true

# Skips TLS certificate verification. Acceptable only against a self-signed
# certificate in a lab; prefer installing a trusted certificate on the router.
#LANQUIRY_SOURCES_ROUTEROS_0_INSECURE_SKIP_VERIFY=true

## Period between polls of each capability.
#LANQUIRY_SOURCES_ROUTEROS_0_POLL_INTERVAL=60s

# TCP connect timeout per attempt.
#LANQUIRY_SOURCES_ROUTEROS_0_DIAL_TIMEOUT=10s

# Timeout per API command.
#LANQUIRY_SOURCES_ROUTEROS_0_COMMAND_TIMEOUT=15s

# Bind the source to specific networks declared in LANQUIRY_NETWORKS. A
# non-empty list makes this file the authority for the source's network
# memberships on every start; leave unset to manage them in the UI.
#LANQUIRY_SOURCES_ROUTEROS_0_NETWORK_IDS=main,guest

# Skip a capability the router does not provide (routers without them degrade
# gracefully anyway).
#LANQUIRY_SOURCES_ROUTEROS_0_WIRELESS_DISABLED=false
#LANQUIRY_SOURCES_ROUTEROS_0_CAPSMAN_DISABLED=false

# Keep the entry but stop polling it.
#LANQUIRY_SOURCES_ROUTEROS_0_ENABLED=false

# Additional sources continue with index 1, 2, ... Indexes are zero-based and
# must be contiguous with no gaps. With multiple sources every entry needs an
# explicit ID (LANQUIRY_SOURCES_ROUTEROS_<n>_ID); a single source defaults to
# ID "routeros". Setting any indexed variable replaces the whole source list,
# and an empty variable value means the field is not set.
#LANQUIRY_SOURCES_ROUTEROS_1_ID=routeros-cabinet
#LANQUIRY_SOURCES_ROUTEROS_1_ADDRESS=192.168.89.1
#LANQUIRY_SOURCES_ROUTEROS_1_USERNAME=lanquiry-readonly
#LANQUIRY_SOURCES_ROUTEROS_1_PASSWORD=replace-with-the-readonly-password

# --- Web interface ------------------------------------------------------------

# Absolute base URL used in links and notifications. Required (https://) for
# the traefik and traefik_host variants; non-loopback http:// URLs are
# rejected at startup.
#LANQUIRY_HTTP_PUBLIC_BASE_URL=https://lanquiry.example.com

# CIDR of the reverse proxy whose forwarded-client headers may be trusted.
# Accepts a single CIDR per value. Find the Traefik network subnet with:
#   docker network inspect traefik --format '{{(index .IPAM.Config 0).Subnet}}'
#LANQUIRY_HTTP_TRUSTED_PROXIES=172.18.0.0/16

# --- Logging -------------------------------------------------------------------

#LANQUIRY_LOGGING_LEVEL=info
#LANQUIRY_LOGGING_FORMAT=json

# --- Local discovery (host / traefik_host variants only) -----------------------
# mDNS and SSDP need host networking; they are force-disabled in the bridge
# variants. `auto` resolves to the host's live interfaces at startup, already
# filtered against container bridges, veth, VPN tunnels, and loopback.
#LANQUIRY_DISCOVERY_INTERFACES=auto

# Declare which networks declared in LANQUIRY_NETWORKS are reachable through
# the discovery interfaces; unlike RouterOS sources, an empty list is an
# explicit "none".
#LANQUIRY_DISCOVERY_NETWORK_IDS=main

# Per-interface poll period and per-browse-pass timeout.
#LANQUIRY_DISCOVERY_POLL_INTERVAL=5m
#LANQUIRY_DISCOVERY_PASS_TIMEOUT=8s

# --- Network zones (advanced) ---------------------------------------------------
# Declares network zones as a JSON array; every start reconciles the database
# to this list. Entries use the same fields as the `networks` configuration
# list: id, name, trust_class (trusted|known|guest|untrusted), subnets (CIDRs),
# and optional vlan_id and dhcp_managed_ranges.
#LANQUIRY_NETWORKS=[{"id":"main","name":"Main LAN","trust_class":"trusted","subnets":["192.168.88.0/24"]}]

# --- Notifications ----------------------------------------------------------------
# Destinations are seeded once by these variables and can be managed in the UI
# afterwards. The URL is a shoutrrr URL, e.g.
#   ntfy://ntfy.example.com/lanquiry-alerts
#   generic://hooks.example.com/lanquiry
#LANQUIRY_NOTIFY_DESTINATIONS_0_ID=ops
#LANQUIRY_NOTIFY_DESTINATIONS_0_URL=ntfy://ntfy.example.com/lanquiry-alerts
#LANQUIRY_NOTIFY_DESTINATIONS_0_LABEL=Ops channel

# Delivery tuning: scan interval, rows per scan, retry backoff, attempt cap,
# and per-delivery timeout.
#LANQUIRY_NOTIFY_DISPATCH_INTERVAL=30s
#LANQUIRY_NOTIFY_BATCH_SIZE=25
#LANQUIRY_NOTIFY_INITIAL_BACKOFF=30s
#LANQUIRY_NOTIFY_MAX_BACKOFF=30m
#LANQUIRY_NOTIFY_MAX_ATTEMPTS=5
#LANQUIRY_NOTIFY_PER_DELIVERY_TIMEOUT=15s

# URL scheme allowlist for destinations (comma-separated).
#LANQUIRY_NOTIFY_ALLOWED_SCHEMES=

# --- Compose stack settings ---------------------------------------------------------

# Compose variant:
#   default      - bridge networking, localhost-bound; mDNS/SSDP disabled
#   traefik      - default plus Traefik labels and the external Traefik network
#   host         - host networking for real mDNS/SSDP discovery
#   traefik_host - host networking plus Traefik labels
#COMPOSE_VARIANT=default

# BIND_ADDRESS/BIND_PORT are the published address and port in the bridge
# variants and the bind address and port in the host variants. The host-variant
# healthcheck follows them automatically.
#BIND_ADDRESS=127.0.0.1
#BIND_PORT=8420

# Host directory holding the SQLite database (WAL mode, so -wal and -shm
# siblings appear next to it).
#HOST_DATA_DIR=./data

# Timezone assigned to the container.
#TZ=UTC

# Optional Traefik settings used by the traefik and traefik_host variants.
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure
# Access policy defaults to default-access@file. Use public-access@file only
# when explicitly exposing the stack.
#TRAEFIK_ACCESS_POLICY=default-access@file
#TRAEFIK_HOST=lanquiry.example.com
# Container-internal service port, used by the bridge traefik variant only
# (the host variants publish the app bind directly).
#TRAEFIK_SERVICE_PORT=8080

# --- Do not set these here -------------------------------------------------------
# The compose variants own the following variables and override anything set in
# this file, so editing them here is silently ignored:
#   LANQUIRY_HTTP_BIND                  (set by the variant from BIND_ADDRESS/BIND_PORT)
#   LANQUIRY_DATABASE_PATH              (fixed to /data/lanquiry.db)
#   LANQUIRY_DISCOVERY_MDNS_DISABLED    (forced on in bridge variants)
#   LANQUIRY_DISCOVERY_SSDP_DISABLED    (forced on in bridge variants)
#
# Environment variables are readable by everyone who can inspect the container
# (docker inspect, /proc/<pid>/environ). When that matters for the RouterOS
# credentials and the admin hash, keep them in a 0600 configuration file and
# start the container with --config instead; see "Environment variables" in the
# configuration reference linked above.
