# zapret2 anti-DPI egress proxy.
# Image: https://github.com/vernette/ss-zapret2 (wraps https://github.com/bol-van/zapret2)
# Strategy tuning lives in config/config (NFQWS2_OPT), not here.

IMAGE_REPOSITORY=vernette/ss-zapret2
# Pinned to the latest published image tag. See the README security notes
# before bumping: the image is unsigned and built from unpinned sources.
IMAGE_TAG=v1.0.2

# External network shared with consumer stacks.
PROXY_NETWORK=proxy

# SOCKS5 entry point. Unauthenticated! Keep the bind address localhost unless
# every network the host is reachable from is fully trusted.
# Consumed in-network as socks5://zapret2:1080
SOCKS_BIND_ADDRESS=127.0.0.1
SOCKS_HOST_PORT=1060
SOCKS_CONTAINER_PORT=1080

# Shadowsocks listener. Container-internal only: it is the encrypted hop
# between ss-local and ss-server and is deliberately not published to the host.
SS_CONTAINER_PORT=8388

# Required. The container refuses to start while this is empty.
# Generate a strong value, e.g.: openssl rand -base64 24
SS_PASSWORD=

# AEAD cipher used between ss-local and ss-server.
SS_ENCRYPT_METHOD=chacha20-ietf-poly1305
SS_TIMEOUT=300
# Set to 1 to enable verbose logging in both shadowsocks binaries.
SS_VERBOSE=0

LOG_MAX_SIZE=5m
LOG_MAX_FILE=5
