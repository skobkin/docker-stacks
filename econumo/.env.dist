# https://econumo.com/docs/self-hosting/
# https://github.com/econumo/econumo/blob/main/.env.example

# Upstream publishes only exact vX.Y.Z release tags (plus latest and dev; no
# rolling v1/v1.6 tags exist). The default `latest` lets watchtower auto-update
# the image, and database migrations run automatically on boot, so back up
# data/ before upgrades. Pin an exact tag to opt out of auto-updates.
# Never use dev.
#IMAGE_TAG=v1.6.1

# Compose variant:
#   default - standalone localhost-bound HTTP port
#   databases - also attach Econumo to the shared databases network
#   traefik - also attach Econumo to the shared Traefik network (no port published)
#   traefik_databases - combine Traefik and shared databases networking (no port published)
COMPOSE_VARIANT=default

BIND_ADDRESS=127.0.0.1
BIND_PORT=8421

# SQLite by default (stored under HOST_DATA_DIR). For PostgreSQL use
# COMPOSE_VARIANT=databases (or traefik_databases) and a postgres:// URL, e.g.:
# DATABASE_URL=postgres://econumo:change-me@postgres:5432/econumo?sslmode=disable
DATABASE_URL=sqlite:///app/var/db/db.sqlite

# Allow account registration through the web UI. Set to false after creating
# your own account (see README).
ECONUMO_ALLOW_REGISTRATION=true

# Public HTTPS origin without a path (no trailing slash, no path component).
# Required for OIDC providers and for browser OAuth sign-in at the MCP
# endpoint; when unset or non-https, /mcp accepts personal access tokens only.
# Keep in sync with TRAEFIK_HOST when using the Traefik variant.
#ECONUMO_URL=https://econumo.example.com

# Server log level: debug, info, warn, error.
#ECONUMO_LOG_LEVEL=info

# Set to false to disable the daily check for new Econumo releases.
#ECONUMO_CHECK_UPDATES=false

# Transactional email (password recovery etc.). Leave unset to print emails to
# stdout (visible via docker logs); upstream supports resend:// transport:
# MAILER_DSN=resend://re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx?from=noreply@yourdomain.com

# Optional OIDC sign-in. Requires ECONUMO_URL. Full setup guide:
# https://github.com/econumo/econumo/blob/main/docs/oidc-setup.md
#ECONUMO_OIDC_ISSUER_URL=
#ECONUMO_OIDC_CLIENT_ID=
#ECONUMO_OIDC_CLIENT_SECRET=
#ECONUMO_OIDC_NAME=
#ECONUMO_OIDC_SCOPES=
#ECONUMO_OIDC_TRUST_EMAIL=

# Optional Traefik settings used by COMPOSE_VARIANT=traefik or traefik_databases.
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure
# Access policy defaults to default-access@file. Note that MCP OAuth clients
# may come from outside your allow-list; see the stack README before changing it.
#TRAEFIK_ACCESS_POLICY=default-access@file
#TRAEFIK_HOST=econumo.example.com
#TRAEFIK_SERVICE_PORT=80

# Optional shared database network used by COMPOSE_VARIANT=databases or traefik_databases.
#DATABASES_NETWORK=databases

# Host directory for the SQLite database, JWT keypair, and other runtime state.
# The image runs as UID/GID 65532 (distroless nonroot): HOST_DATA_DIR plus its
# db/ and jwt/ subdirectories must exist and be writable by 65532 before first
# start (see README).
HOST_DATA_DIR=./data

# Standard repo logging defaults.
LOG_MAX_SIZE=5m
LOG_MAX_FILE=5

# Timezone passed to the container.
#TZ=UTC
