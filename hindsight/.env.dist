# Stable minor tag: receive 0.9.x fixes without crossing a minor release.
IMAGE_TAG=0.9

# Compose variant: default or traefik.
COMPOSE_VARIANT=default

# Used by COMPOSE_VARIANT=traefik. One hostname serves both the API and UI.
#TRAEFIK_HOST=hindsight.example.com
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure

# default-access@file = the shared access policy configured for this host.
# Keep the policy compatible with non-browser API and MCP clients.
#TRAEFIK_ACCESS_POLICY=default-access@file

# Local maintenance endpoints. Keep these localhost-bound when using Traefik.
API_BIND_ADDR=127.0.0.1
API_BIND_PORT=8419
UI_BIND_ADDR=127.0.0.1
UI_BIND_PORT=8418

# Embedded pg0 data. The image runs as UID/GID 1000.
HOST_DATA_DIR=./data

# PostgreSQL uses shared memory for query execution. 1 GiB is a good default
# for Hindsight's embedded pg0 deployment.
SHM_SIZE=1g

# Keep this stable for the lifetime of the instance.
HINDSIGHT_API_WORKER_ID=hindsight-1

# Generate two different values with: openssl rand -hex 32
# HINDSIGHT_API_KEY protects the REST API and MCP endpoint. Clients use it as
# a Bearer token. HINDSIGHT_CP_ACCESS_KEY protects the Control Plane login.
HINDSIGHT_API_KEY=replace-with-generated-api-key
HINDSIGHT_CP_ACCESS_KEY=replace-with-generated-control-plane-key

# LLM provider: local llama-swap on the mandatory ai-tools network.
# The configured llama-swap instance must expose this model alias.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=http://llama-swap:8080/v1
HINDSIGHT_API_LLM_API_KEY=none
HINDSIGHT_API_LLM_MODEL=gemma-4-e4b-noreason
# Recommended for weaker self-hosted models producing structured output.
HINDSIGHT_API_LLM_STRICT_SCHEMA=true

# Cheap cloud alternative: comment the four active llama-swap variables above,
# then uncomment these three lines. The native provider uses MiniMax's global
# API endpoint, so HINDSIGHT_API_LLM_BASE_URL must remain unset.
#HINDSIGHT_API_LLM_PROVIDER=minimax
#HINDSIGHT_API_LLM_API_KEY=replace-with-minimax-api-key
#HINDSIGHT_API_LLM_MODEL=MiniMax-M3

# Providers include openai, openai-responses, anthropic, gemini, vertexai,
# groq, minimax, deepseek, zai, opencode-go, atlas, volcano, openrouter,
# requesty, openai-codex, claude-code, bedrock, fireworks, nous, ollama,
# ollama-cloud, lmstudio, llamacpp, litellm, litellmrouter, and none.
# Documentation: https://hindsight.vectorize.io/developer/models

LOG_MAX_SIZE=5m
LOG_MAX_FILE=5
