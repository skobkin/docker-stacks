# Samba image tag (verified stable at time of writing; see upstream releases:
# https://github.com/crazy-max/docker-samba/tags).
IMAGE_TAG=4.23.8-r0

# Timezone assigned to the container.
TZ=UTC

# Host paths.
# HOST_CONFIG_DIR holds the operator's real config.yml (tracked as
# config.yml.dist template, real file is gitignored). The image
# expects /data inside the container, so this host path is bind-
# mounted to /data in docker-compose.yml.
HOST_CONFIG_DIR=./config
# HOST_STORAGE_DIR is the host path bind-mounted to /storage inside the
# container. Operators typically point Samba share `path:` entries at
# subdirectories of this location. The default below is a generic
# placeholder so the stack can be rendered for validation; replace it
# with the real host path on the deployment host (for example
# /srv/samba, /mnt/storage, or /var/samba). Compose still enforces
# `${HOST_STORAGE_DIR:?...}` so clearing the value trips an error.
HOST_STORAGE_DIR=/srv/samba
# SECRETS_DIR holds password files referenced by `password_file` in
# config/config.yml. Each file is mounted read-only into /run/secrets.
SECRETS_DIR=./secrets

# Generic Samba image-level settings (see upstream docs:
# https://github.com/crazy-max/docker-samba#environment-variables).
# Deployment-specific knobs such as SAMBA_HOSTS_ALLOW, SAMBA_INTERFACES,
# and service discovery (AVAHI_*, WSDD2_*) are deliberately not exposed
# here; configure them per deployment.
SAMBA_LOG_LEVEL=0
SAMBA_WORKGROUP=WORKGROUP
SAMBA_SERVER_STRING=Docker Samba Server

# Standard repo logging defaults.
LOG_MAX_SIZE=5m
LOG_MAX_FILE=5
