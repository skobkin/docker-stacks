# Minimal structure for ghcr.io/crazy-max/samba.
# https://github.com/crazy-max/docker-samba#configuration
#
# Three top-level keys are recognized:
#   auth:   list of Samba users (with uid/gid and either `password` or
#           `password_file`). Passwords SHOULD be supplied via files in
#           ../secrets/ referenced as `password_file: /run/secrets/<name>`.
#           See ../secrets/.gitignore — drop a file there, set its mode
#           to 0400, and reference it here.
#   global: list of smb.conf [global] options, each a "key = value" string.
#   share:  list of share definitions; each share's `path:` is a path
#           inside the container (commonly a subdirectory of /storage).
#
# The operator is expected to copy this file to data/config.yml and fill
# in users, shares, and trusted-network policy (e.g. hosts allow, veto,
# recycle, per-share options) to match their actual deployment. The
# generic stack intentionally ships no real users, shares, or networks.

auth: []
share: []