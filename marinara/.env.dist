# Marinara Engine configuration
# https://github.com/Pasta-Devs/Marinara-Engine

# `latest` tracks the current stable release of the full image: the
# complete application. Full is the default here for its application
# features (built-in Memory Recall) - not for its bundled inference; the
# README describes running every model role through llama-swap with the
# built-in local model kept dormant. Pin an exact full tag such as 2.5.2
# when reproducibility matters more than tracking upstream.
#
# `lite` (IMAGE_TAG=lite, pin with X.Y.Z-lite) is the smaller variant
# without the bundled local models. It hard-disables built-in Memory
# Recall, which no external embedding source can restore (see README).
#
# Never pin 2.0.9 - 2.3.3: those releases were withdrawn upstream for a
# security issue and their artifacts were removed. Back up ./data before
# any version change: the current stable line applies a one-way storage
# migration, so rolling back after it ran means losing access to the data
# (see README).
IMAGE_REPOSITORY=ghcr.io/pasta-devs/marinara-engine
IMAGE_TAG=latest

# Compose variant. Traefik is the default; non-Traefik variants are the opt-out.
#   traefik - publish through the shared Traefik network (no host port)
#   default - standalone localhost-bound HTTP port
COMPOSE_VARIANT=traefik

# Host bind for the non-Traefik variant (default). Keep localhost-bound
# while no password is set; widen the address only when another network
# layer protects the port.
BIND_ADDRESS=127.0.0.1
BIND_PORT=7860

# All persistent state (JSON files, uploads, .encryption-key, in-app
# backups). The container starts as root, repairs ownership of this
# directory, then drops privileges - no manual chown needed.
HOST_DATA_DIR=./data

# Allow provider base URLs on private/LAN addresses such as
# http://llama-swap:8080/v1. Disabled upstream by default; required for
# the llama-swap wiring documented in README.md.
PROVIDER_LOCAL_URLS_ENABLED=true

# Timezone used inside the container.
#TZ=UTC

# --- Required for the default Traefik variant -------------------------
# With COMPOSE_VARIANT=traefik the container healthcheck validates that
# everything in this section is set: until then the container reports
# unhealthy and names the missing settings in its health log, and
# `docker compose up -d --wait` fails. The standalone default variant
# does not require any of them.

# Host name Traefik routes to this stack.
#TRAEFIK_HOST=marinara.example.com

# Authentication. Since v2.4.0 Marinara requires authentication for
# traffic arriving through a reverse proxy, so the Traefik variant stays
# locked until all three are set. Without them the app accepts localhost
# connections only. Generate secrets with: openssl rand -hex 32
#BASIC_AUTH_USER=
#BASIC_AUTH_PASS=
# Docker installs need ADMIN_SECRET for privileged actions (backups,
# data clearing, updates, runtime install).
#ADMIN_SECRET=

# Reverse proxy / cross-origin settings, required together with the
# auth vars above.
#TRUSTED_HOSTS=marinara.example.com
#CSRF_TRUSTED_ORIGINS=https://marinara.example.com
#CORS_ORIGINS=https://marinara.example.com

# Optional tuning. IMAGE_LOCAL_URLS_ENABLED is the image-provider
# analogue of PROVIDER_LOCAL_URLS_ENABLED.
#IMAGE_LOCAL_URLS_ENABLED=true
# Embedding request timeout in ms (upstream default 300000 = 5 minutes).
#EMBEDDING_TIMEOUT_MS=300000
#LOG_LEVEL=debug
# JSON-formatted container logs (v2.5.2+).
#LOG_FORMAT=json
# Poll /app/data/.env for changes instead of relying on file-watch events,
# needed when the env file is edited from the host through the bind mount.
#MARINARA_ENV_WATCH=poll
# Explicit encryption key; when unset the app generates .encryption-key
# in the data dir on first start.
#ENCRYPTION_KEY=
# Skip the startup ownership repair for the data dir (escape hatch).
#MARINARA_SKIP_DATA_CHOWN=true

# Logging
LOG_MAX_SIZE=5m
LOG_MAX_FILE=5

# Traefik settings used by COMPOSE_VARIANT=traefik.
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure
# default-access@file = default policy for this host.
# public-access@file = unauthenticated, exposed publicly.
#TRAEFIK_ACCESS_POLICY=default-access@file
#TRAEFIK_SERVICE_PORT=7860
