# Marinara Engine configuration
# https://github.com/Pasta-Devs/Marinara-Engine

# `lite` tracks the current stable release of the lite image (no bundled
# local models). Switch to the full image for Memory Recall with
# IMAGE_TAG=latest (rolling) or a pinned full tag such as 2.4.4. Pin the
# lite line with 2.4.4-lite when reproducibility matters more than
# tracking upstream.
IMAGE_REPOSITORY=ghcr.io/pasta-devs/marinara-engine
IMAGE_TAG=lite

# Compose variant:
#   default - localhost-bound container on the ai-tools network
#   traefik - adds Traefik labels and joins the external Traefik network
#COMPOSE_VARIANT=default

# Local web UI endpoint. Keep localhost-bound while no password is set;
# widen the address only when another network layer protects the port.
HTTP_BIND_ADDR=127.0.0.1
HTTP_BIND_PORT=7860

# All persistent state (JSON files, uploads, .encryption-key, in-app
# backups). The container starts as root, repairs ownership of this
# directory, then drops privileges - no manual chown needed.
HOST_DATA_DIR=./data

# Allow provider base URLs on private/LAN addresses such as
# http://llama-swap:8080/v1. Disabled upstream by default; required for
# the llama-swap wiring documented in README.md.
PROVIDER_LOCAL_URLS_ENABLED=true

# Seed the initial default connection on first start (upstream default).
AUTO_CREATE_DEFAULT_CONNECTION=true

# Timezone used inside the container.
#TZ=UTC

# Authentication. Marinara is localhost-only with no password while all
# three are unset. Set ALL THREE before any non-localhost exposure
# (Traefik or a wider HTTP_BIND_ADDR). They reach the container via
# env_file, no compose changes needed.
#BASIC_AUTH_USER=
#BASIC_AUTH_PASS=
#ADMIN_SECRET=

# Reverse proxy / cross-origin settings, needed for Traefik exposure
# together with the auth vars above.
#TRUSTED_HOSTS=marinara.example.com
#CSRF_TRUSTED_ORIGINS=https://marinara.example.com
#CORS_ORIGINS=https://marinara.example.com

# Optional tuning. IMAGE_LOCAL_URLS_ENABLED is the image-provider
# analogue of PROVIDER_LOCAL_URLS_ENABLED.
#IMAGE_LOCAL_URLS_ENABLED=true
# Embedding request timeout in ms (upstream default 300000 = 5 minutes).
#EMBEDDING_TIMEOUT_MS=300000
#LOG_LEVEL=debug
# Explicit encryption key; when unset the app generates .encryption-key
# in the data dir on first start.
#ENCRYPTION_KEY=
# Skip the startup ownership repair for the data dir (escape hatch).
#MARINARA_SKIP_DATA_CHOWN=true

# Logging
LOG_MAX_SIZE=5m
LOG_MAX_FILE=5

# Traefik settings used by COMPOSE_VARIANT=traefik.
#TRAEFIK_HOST=marinara.example.com
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure
# default-access@file = default policy for this host.
# public-access@file = unauthenticated, exposed publicly.
#TRAEFIK_ACCESS_POLICY=default-access@file
#TRAEFIK_SERVICE_PORT=7860
